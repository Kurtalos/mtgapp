# ---------------------------------------------------------------------------
# Mana Table — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your values.
#
# IMPORTANT: with both values left blank the app still runs. It falls back to
# "local mode", where rooms live in the browser (synced across tabs via
# BroadcastChannel). That is perfect for developing, for a single-tablet game,
# and for kicking the tyres before you wire up a database.
#
# To let everyone join from their own phone on different devices you need a
# shared backend. Supabase's free tier is plenty for a playgroup.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. This one is safe to expose to the browser,
# because row level security is what actually protects your data.
# Never put your service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
