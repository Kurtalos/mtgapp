# ---------------------------------------------------------------------------
# Mana Table — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in what you need.
#
# EVERYTHING HERE IS OPTIONAL. With an empty file the app runs fully featured:
# rooms are stored on this server's disk and pushed to every phone over SSE.
# That is the recommended setup for a small VPS.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# selfhosted  — rooms on this server's disk (default)
# supabase    — rooms in a Supabase project (you must set the two keys below)
# local       — no server at all; rooms live in the browser and sync between
#               tabs. Handy for a single tablet, or for poking at the UI.
#
# Leave unset for "auto": Supabase if the keys below are present, otherwise
# selfhosted.
# NEXT_PUBLIC_BACKEND=selfhosted

# Where room files are written. Relative paths resolve from the app directory.
# In Docker this should point at a mounted volume so rooms survive a redeploy.
# DATA_DIR=./.data/rooms

# Only set this if the realtime backend lives on a different host or path.
# Defaults to the bundled /api/rt routes.
# NEXT_PUBLIC_REALTIME_URL=https://example.com/api/rt

# ---------------------------------------------------------------------------
# Supabase (only if NEXT_PUBLIC_BACKEND=supabase)
# ---------------------------------------------------------------------------
# The anon key is safe to expose to the browser — row level security is what
# actually protects the data. Never put your service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
